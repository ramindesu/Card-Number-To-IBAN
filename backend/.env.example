APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://card_to_iban:card_to_iban@localhost:5432/card_to_iban?sslmode=disable

ZARINHUB_BASE_URL=https://zarin-hub.com
ZARINHUB_API_USERNAME=your-api-username
ZARINHUB_API_PASSWORD=your-api-password
ZARINHUB_REQUEST_TIMEOUT=10s
ZARINHUB_REQUEST_HANDLING_TYPE=standard

CARD_FINGERPRINT_KEY=replace-with-a-random-32-byte-secret

LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
