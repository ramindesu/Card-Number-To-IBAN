APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

DATABASE_NAME=zarrinpal
DATABASE_USER=your-database-user
DATABASE_PASSWORD=your-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_SSL_MODE=disable
DATABASE_CONNECT_TIMEOUT=5s

ZARINHUB_BASE_URL=https://zarin-hub.com
ZARINHUB_API_USERNAME=your-api-username
ZARINHUB_API_PASSWORD=your-api-password
ZARINHUB_REQUEST_TIMEOUT=10s
ZARINHUB_REQUEST_HANDLING_TYPE=standard

CARD_FINGERPRINT_KEY=replace-with-a-random-32-byte-secret

LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
